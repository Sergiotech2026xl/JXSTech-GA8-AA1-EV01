  "item": [
    {
      "name": "01 — Disponibilidad",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/salud",
        "description": "Resultado esperado: HTTP 200. Ejecutar la colección en orden.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 200', () => pm.response.to.have.status(200));",
              "const respuesta = pm.response.json();",
              "pm.test('Respuesta JSON válida', () => pm.expect(respuesta).to.be.an('object'));",
              "pm.test('Servicio disponible', () => pm.expect(respuesta.estado).to.eql('disponible'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Registrar operador de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/usuarios/registro",
        "description": "Resultado esperado: HTTP 201. Ejecutar la colección en orden.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuario}}\",\n  \"password\": \"PruebaSena2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString() + Math.floor(Math.random() * 10000).toString().padStart(4, '0');",
              "pm.collectionVariables.set('runId', runId);",
              "pm.collectionVariables.set('usuario', 'ev03_' + runId);",
              "for (const key of ['token', 'clienteId', 'relojId', 'audioId', 'ventaId']) pm.collectionVariables.set(key, '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 201', () => pm.response.to.have.status(201));",
              "const respuesta = pm.response.json();",
              "pm.test('Respuesta JSON válida', () => pm.expect(respuesta).to.be.an('object'));"
            ]
          }
        }
      ]
    },
