{
  "info": {
    "name": "JXSTech — GA7-AA5-EV03",
    "description": "Ejecutar en orden con Collection Runner. Crea datos ficticios nuevos en cada ejecución. Los datos quedan en la base configurada; no usar contra datos reales. No contiene credenciales ni tokens reales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "usuario",
      "value": "",
      "type": "string"
    },
    {
      "key": "clienteId",
      "value": "",
      "type": "string"
    },
    {
      "key": "relojId",
      "value": "",
      "type": "string"
    },
    {
      "key": "audioId",
      "value": "",
      "type": "string"
